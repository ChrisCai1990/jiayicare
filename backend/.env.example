PORT=3000
MONGODB_URI=mongodb+srv://<用户名>:<密码>@cluster0.xxxxx.mongodb.net/jiayicare?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=30d
NODE_ENV=development

# 仅在对应账号不存在时使用；创建成功后可从运行环境中移除。
BOOTSTRAP_ADMIN_PASSWORD=
PLATFORM_ADMIN_PASSWORD=

# 演示/测试账号默认关闭，生产环境不要启用。
SEED_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=

# 固定验证码登录默认关闭；仅用于隔离的演示环境。
ENABLE_DEMO_LOGIN=false
DEMO_LOGIN_PHONE=

# AI辅助研判供应商。WorkBuddy Enterprise 在“企业智能体 → 开发集成 → API 集成”生成以下配置；
# 凭据只配置在测试/生产运行环境，不写入仓库。未配置时 auto 会回退到 QWEN_API_KEY 或 DEEPSEEK_API_KEY。
WORKBUDDY_API_URL=
WORKBUDDY_API_KEY=
WORKBUDDY_AGENT_ID=
# WorkBuddy 云端读取本系统图片时使用的公网 API 根地址；隔离测试环境需配置测试域名。
PUBLIC_API_ORIGIN=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
