{
  "expo": {
    "name": "嘉医汇健康管家",
    "slug": "jiayicare",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/jiayicare-brand-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/jiayicare-brand-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.jiayicare.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "需要访问相册，以便上传体检报告照片",
        "NSCameraUsageDescription": "需要使用相机，以便拍摄体检报告"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/jiayicare-brand-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.jiayicare.app",
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "需要访问相册，以便上传体检报告照片",
          "cameraPermission": "需要使用相机，以便拍摄体检报告"
        }
      ]
    ],
    "extra": {
      "release": {
        "privacyPolicyUrl": "https://app.joinwehealth.com/privacy-policy.html"
      },
      "eas": {
        "projectId": "87f6e7f1-8bbe-4969-8faf-1954318111a7"
      }
    },
    "owner": "chriscai"
  }
}
